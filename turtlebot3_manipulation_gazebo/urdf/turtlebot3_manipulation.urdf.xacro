<?xml version="1.0"?>
<!-- TurtleBot3 Manipulation -->
<robot name="turtlebot3_manipulation" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="use_sim" default="false" />

  <xacro:arg name="use_fake_hardware" default="false" />
  <xacro:arg name="fake_sensor_commands" default="false" />

  <!-- Import materials macro -->
  <xacro:include filename="$(find turtlebot3_manipulation_gazebo)/gazebo/materials.xacro" />

  <!-- Include TurtleBot3 Waffle Pi urdf macro -->
  <xacro:include filename="$(find turtlebot3_manipulation_gazebo)/urdf/turtlebot3_waffle_pi.urdf.xacro" />

  <!-- Include TurtleBot3 Waffle Pi gazebo macro -->
  <xacro:include filename="$(find turtlebot3_manipulation_gazebo)/gazebo/turtlebot3_waffle_pi.gazebo.xacro" />

  <!-- Include FR3 arm macros (URDF only, no ros2_control block) -->
  <xacro:include filename="$(find franka_description)/robots/common/utils.xacro" />
  <xacro:include filename="$(find franka_description)/robots/common/franka_arm.xacro" />
  <xacro:include filename="$(find franka_description)/end_effectors/common/franka_hand.xacro" />
  <xacro:include filename="$(find franka_description)/end_effectors/common/utils.xacro" />

  <!-- Include TurtleBot3 + FR3 combined ros2 control macro -->
  <xacro:include filename="$(find turtlebot3_manipulation_gazebo)/ros2_control/turtlebot3_manipulation_system.ros2_control.xacro" />

  <xacro:turtlebot3_waffle_pi prefix="$(arg prefix)" />
  <xacro:turtlebot3_waffle_pi_gazebo prefix="$(arg prefix)" />

  <!-- FR3 riser column — raises the arm so joint1 reaches table height (~0.76 m).
       Riser sits on the base deck (z=0.091) and is 0.33 m tall.
       fr3_link0 ends at z=0.421 above base_link → joint1 at z≈0.764 m. -->
  <link name="$(arg prefix)fr3_riser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.07" length="0.33"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.07" length="0.33"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <!-- Attach riser column to TurtleBot3 base deck -->
  <joint name="$(arg prefix)fr3_riser_mount" type="fixed">
    <parent link="$(arg prefix)base_link"/>
    <child link="$(arg prefix)fr3_riser"/>
    <origin xyz="-0.092 0.0 0.256" rpy="0 0 0"/>
  </joint>

  <!-- Attach FR3 arm to top of riser column -->
  <joint name="$(arg prefix)fr3_base_mount" type="fixed">
    <parent link="$(arg prefix)fr3_riser"/>
    <child link="fr3_link0"/>
    <origin xyz="0 0 0.165" rpy="0 0 0"/>
  </joint>

  <!-- FR3 7-DOF arm (connected_to="" so we manually handle attachment) -->
  <xacro:franka_arm
      robot_type="fr3"
      arm_prefix=""
      connected_to=""
      gazebo="true"
      with_sc="false"
      safety_distance="0.03">
  </xacro:franka_arm>

  <!-- FR3 hand + fingers, attached to flange fr3_link8 -->
  <xacro:franka_hand
      connected_to="fr3_link8"
      robot_type="fr3"
      arm_prefix=""
      ee_id="franka_hand_white"
      ee_inertials="${xacro.load_yaml('$(find franka_description)/end_effectors/franka_hand/inertials.yaml')}"
      rpy_ee="0 0 ${-pi/4}"
      tcp_xyz="0 0 0.1034"
      tcp_rpy="0 0 0"
      safety_distance="0.03"
      gazebo="true"
      description_pkg="franka_description"
      with_sc="false">
  </xacro:franka_hand>

  <xacro:turtlebot3_manipulation_system
    name="TurtleBot3ManipulationSystem" prefix="$(arg prefix)" use_sim="$(arg use_sim)"
    use_fake_hardware="$(arg use_fake_hardware)"
    fake_sensor_commands="$(arg fake_sensor_commands)"/>

  <gazebo>
    <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin"
            filename="gz_ros2_control-system">
      <parameters>$(find turtlebot3_manipulation_gazebo)/config/gazebo_controller_manager.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
